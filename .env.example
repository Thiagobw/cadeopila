# ── PostgreSQL Admin ────────────────────────────────────────────────────
# Superusuário criado pelo entrypoint do postgres:17.11
POSTGRES_USER=cadeopila_admin
POSTGRES_PASSWORD=change_me_admin

# ── user-service → users_db ─────────────────────────────────────────────
USERS_DB_USER=user_svc
USERS_DB_PASSWORD=change_me_user

# ── transaction-service → transactions_db ───────────────────────────────
TRANSACTIONS_DB_USER=transaction_svc
TRANSACTIONS_DB_PASSWORD=change_me_transaction

# ── Spring (compartilhado) ───────────────────────────────────────────────
# update  → cria/altera tabelas automaticamente (dev)
# validate → apenas valida o schema (produção)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── transaction-service → integrações externas (MS2) ─────────────────────
# Conta: saldo e limites (hoje no MockAPI). URL base, SEM /accounts.
# Sensível: o token fica no subdomínio e dá acesso de escrita aos saldos — não compartilhe.
ACCOUNT_API_BASE_URL=https://SEU-TOKEN.mockapi.io/api/v1

# Câmbio (BrasilAPI PTAX). URL base, SEM /cambio/v1/cotacao/...
EXCHANGE_API_BASE_URL=https://brasilapi.com.br/api

# ── transaction-service → autenticação (MS2 valida o Basic Auth no MS1) ───
# Aponta para o user-service. Em Docker Compose use o NOME DO SERVIÇO, não localhost.
# (O docker-compose.yml já tem este default; só sobrescreva aqui se precisar.)
USER_API_BASE_URL=http://user-service:8080