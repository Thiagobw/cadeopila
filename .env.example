# ── PostgreSQL Admin ────────────────────────────────────────────────────
# Superusuário criado pelo entrypoint do postgres:17.11
POSTGRES_USER=cadeopila_admin
POSTGRES_PASSWORD=change_me_admin

# ── user-service → users_db ─────────────────────────────────────────────
USERS_DB_USER=user_svc
USERS_DB_PASSWORD=change_me_user

# ── transaction-service → transactions_db ───────────────────────────────
TRANSACTIONS_DB_USER=transaction_svc
TRANSACTIONS_DB_PASSWORD=change_me_transaction

# ── Spring (compartilhado) ───────────────────────────────────────────────
# update  → cria/altera tabelas automaticamente (dev)
# validate → apenas valida o schema (produção)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
